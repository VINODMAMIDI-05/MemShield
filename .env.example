# MemShield Environment Configuration (Template)

# App
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# MongoDB (For Audit Logs & Document Store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Security (JWT Auth)
JWT_SECRET=super-secure-default-change-me-in-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# For SQLite MVP: sqlite:///./memshield.db
# For PostgreSQL Production: postgresql://user:pass@localhost:5432/memshield
DATABASE_URL=sqlite:///./memshield.db

# AI Provider Gateway
# Options: local, openai
AI_PROVIDER=openai
AI_API_KEY=your-openai-key-here
AI_MODEL=gpt-4o-mini
